REVENIUM_METERING_API_KEY=your-revenium-api-key
REVENIUM_METERING_BASE_URL=https://api.revenium.ai
REVENIUM_TEAM_ID=
REVENIUM_ENFORCEMENT_API_KEY=
# Job outcomes need a write key (rev_sk_); Revenium refuses the metering key for them. Keep it separate from REVENIUM_METERING_API_KEY.
# REVENIUM_WRITE_API_KEY=
REVENIUM_DEBUG=false
REVENIUM_PRINT_SUMMARY=
REVENIUM_CAPTURE_PROMPTS=false
REVENIUM_MAX_PROMPT_SIZE=50000
REVENIUM_API_TIMEOUT=10s
REVENIUM_ORGANIZATION_NAME=
REVENIUM_PRODUCT_NAME=
REVENIUM_ENVIRONMENT=
REVENIUM_REGION=
REVENIUM_CREDENTIAL_ALIAS=
REVENIUM_TRACE_TYPE=
REVENIUM_TRACE_NAME=
REVENIUM_PARENT_TRANSACTION_ID=
REVENIUM_TRANSACTION_NAME=
REVENIUM_TICKET_ID=
REVENIUM_AGENTIC_JOB_ID=
REVENIUM_AGENTIC_JOB_NAME=
REVENIUM_AGENTIC_JOB_TYPE=
REVENIUM_AGENTIC_JOB_VERSION=

OPENAI_API_KEY=your-openai-key

# Azure OpenAI: setting both the key and the endpoint switches the openai package to Azure.
# Uncomment only for an Azure deployment. REVENIUM_AZURE_DISABLE=true turns Azure detection off.
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT_MODELS=my-dalle=dall-e-3,my-tts=tts-1
# REVENIUM_AZURE_DISABLE=false

ANTHROPIC_API_KEY=your-anthropic-key

GOOGLE_API_KEY=your-google-key

# Google Vertex AI: setting a project switches the google package to Vertex AI.
# Uncomment only for Vertex AI. REVENIUM_VERTEX_DISABLE=true turns Vertex detection off.
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
# GOOGLE_CLOUD_LOCATION=us-central1
# REVENIUM_VERTEX_DISABLE=false

PERPLEXITY_API_KEY=your-perplexity-key

FAL_KEY=your-fal-key

RUNWAY_API_KEY=your-runway-key

GROQ_API_KEY=your-groq-key

XAI_API_KEY=your-xai-key

OLLAMA_BASE_URL=http://localhost:11434/v1

LITELLM_PROXY_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-key
